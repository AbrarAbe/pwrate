#!/usr/bin/env sh

# pwrate - PipeWire sample rate manager
# Requires: pipewire, gum (https://github.com/charmbracelet/gum)

if ! command -v pw-metadata >/dev/null 2>&1; then
    echo "Error: pipewire is not installed. Please install pipewire to use this script."
    exit 1
fi

if ! command -v gum >/dev/null 2>&1; then
    echo "Error: gum is not installed. Install it from https://github.com/charmbracelet/gum"
    exit 1
fi

clear_screen() {
    if command -v tput >/dev/null 2>&1 && tput clear >/dev/null 2>&1; then
        tput clear
    else
        printf '\033[2J\033[H'
    fi
}

header() {
    # "--" is required: gum (kong) otherwise parses leading-dash text like
    # separator lines as unknown flags.
    gum style --bold --foreground 212 -- "$1"
    gum style --foreground 240 -- "-------------------------------------------"
}

khz_to_hz() {
    # Convert kHz to Hz with shell arithmetic (no bc). Accepts "48" and "44.1".
    case $1 in
    *.*)
        int_part=${1%%.*}
        frac_part=${1#*.}
        case ${#frac_part} in
        1) frac_part="${frac_part}00" ;;
        2) frac_part="${frac_part}0" ;;
        esac
        [ -z "$int_part" ] && int_part=0
        echo $((int_part * 1000 + frac_part))
        ;;
    *) echo $(($1 * 1000)) ;;
    esac
}

valid_rate() {
    # Reject empty, leading dot, non-numeric, or multi-dot input like "4.4.1".
    case $1 in
    '' | .* | *[!0-9.]*) return 1 ;;
    esac
    case ${1#*.} in
    *[!0-9]* | '') return 1 ;;
    esac
    return 0
}

set_rate() {
    # $1: rate in Hz, $2: human-readable label
    pw-metadata -n settings 0 clock.force-rate "$1" >/dev/null 2>&1
    gum style --foreground 46 -- "Sample rate set to: $2"
}

get_current_rate() {
    meta=$(pw-metadata -n settings)
    force_rate=$(printf '%s\n' "$meta" | grep "key:'clock.force-rate'" | cut -d "'" -f 4)
    rate=$(printf '%s\n' "$meta" | grep "key:'clock.rate'" | cut -d "'" -f 4)
    allowed=$(printf '%s\n' "$meta" | grep "key:'clock.allowed-rates'" | cut -d "'" -f 4)
    quantum=$(printf '%s\n' "$meta" | grep "key:'clock.quantum'" | cut -d "'" -f 4)

    if [ -n "$force_rate" ] && [ "$force_rate" != "0" ]; then
        printf '%-16s%s\n' "Active rate:" "${force_rate} (forced)"
        printf '%-16s%s\n' "Default rate:" "$rate"
    else
        printf '%-16s%s\n' "Active rate:" "auto (default ${rate})"
    fi
    printf '%-16s%s\n' "Allowed rates:" "$allowed"
    printf '%-16s%s\n' "Quantum:" "$quantum"
}

# After any action the main loop redraws the menu, and the status panel
# above always reflects the latest state - no separate confirmation screen.
main_menu() {
    clear_screen
    header "pwrate - PipeWire Sample Rate Manager"
    get_current_rate
    gum style --foreground 240 -- "-------------------------------------------"
    # Assign gum's result to a global so this function's informational
    # output (above) is not swallowed by command substitution by callers.
    MAIN_CHOICE=$(gum choose --height 11 \
        "Set custom sample rate" \
        "Set sample rate to 44.1kHz" \
        "Set sample rate to 48kHz" \
        "Set sample rate to 96kHz" \
        "Set sample rate to 192kHz" \
        "Set sample rate to 384kHz" \
        "Reset sample rate to default" \
        "Show pactl info" \
        "Show current PipeWire processes" \
        "Exit") || exit 0
}

while true; do
    main_menu

    case $MAIN_CHOICE in
    "Set custom sample rate")
        clear_screen
        header "Set custom sample rate"
        khz=$(gum input --header "Enter custom sample rate in kHz" --placeholder "e.g. 48 or 44.1") || exit 0
        if valid_rate "$khz"; then
            hz=$(khz_to_hz "$khz")
            set_rate "$hz" "${khz}kHz"
        else
            gum style --foreground 196 -- "Invalid rate: $khz"
        fi
        ;;
    "Set sample rate to 44.1kHz") set_rate 44100 "44.1kHz" ;;
    "Set sample rate to 48kHz") set_rate 48000 "48kHz" ;;
    "Set sample rate to 96kHz") set_rate 96000 "96kHz" ;;
    "Set sample rate to 192kHz") set_rate 192000 "192kHz" ;;
    "Set sample rate to 384kHz") set_rate 384000 "384kHz" ;;
    "Reset sample rate to default") set_rate 0 "default" ;;
    "Show pactl info")
        echo "PulseAudio Server Info"
        {
            pactl info
            echo
            pactl stat
        } | gum pager
        ;;
    "Show current PipeWire processes")
        pw-top
        ;;
    "Exit")
        exit 0
        ;;
    *)
        gum style --foreground 196 -- "Invalid option"
        exit 1
        ;;
    esac
done
