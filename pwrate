#!/usr/bin/env sh

if ! command -v pw-metadata &> /dev/null
then
  echo "Error: pipewire is not installed. Please install pipewire to use this script."
  exit 1
fi

clear_screen() {
  if command -v tput > /dev/null 2>&1 && tput clear > /dev/null 2>&1; then
    tput clear
  else
    printf '\033[2J\033[H'
  fi
}

get_current_rate() {
  echo "-------------------------------------------"
  current_rate=$(pw-metadata -n settings | grep 'clock.force-rate' | cut -d "'" -f 4)

  if [ "$current_rate" = "0" ]; then
    current_rate=$(pw-metadata -n settings | grep 'clock.rate' | cut -d "'" -f 4)
    echo "Current sample rate: ${current_rate} (default)"
  else
    echo "Current sample rate: ${current_rate}"
  fi

  echo "-------------------------------------------"
  echo "Current PipeWire Settings:"

  pw-metadata -n settings |
    grep -E "key:'clock\.(rate|force-rate|allowed-rates|quantum)'" |
    awk -F"'" '{
      key = $2
      val = $4
      if (key == "clock.force-rate" && val == "0")
        next
      if (key == "clock.force-rate")
        val = val " (current)"
      printf "  %-19s: %s\n", key, val
    }'
}

get_current_rate

options_prompt() {
    echo "-------------------------------------------"
    echo "Options:"
    echo "1. Back to main menu"
    echo "2. Show current settings"
    echo "3. Exit"
    echo ""
    read -p "Choose an option: " custom_option || exit 0
    case $custom_option in
      1)
        clear_screen
        echo "-------------------------------------------"
        get_current_rate
        return 0
        ;;
      2)
        clear_screen
        get_current_rate
        ;;
      3)
        exit 0
        ;;
      *)
        echo "Invalid option"
        return 1
        ;;
    esac
}
while true; do
  echo "-------------------------------------------"
  echo "Options:"
  echo "1. Set custom sample rate"
  echo "2. Set sample rate to 44.1khz"
  echo "3. Set sample rate to 48khz"
  echo "4. Set sample rate to 96khz"
  echo "5. Set sample rate to 192khz"
  echo "6. Set sample rate to 384khz"
  echo "7. Reset sample rate to default"
  echo "8. Show current settings"
  echo "9. Show pactl info"
  echo "10. Show current PipeWire processes"
  echo ""
  read -p "Choose an option: " option || exit 0
  clear_screen

  case $option in
    1)
      echo "-------------------------------------------"
      read -p "Enter custom sample rate in khz: " custom_rate_khz || exit 0
      custom_rate=$(echo "$custom_rate_khz * 1000" | bc)
      pw-metadata -n settings 0 clock.force-rate "$custom_rate" > /dev/null 2>&1
      echo "Sample rate set to: ${custom_rate_khz}khz"
      while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    2)
      echo "-------------------------------------------"
      pw-metadata -n settings 0 clock.force-rate 44100 > /dev/null 2>&1
      echo "Sample rate set to 44.1khz"
      while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    3)
      echo "-------------------------------------------"
      pw-metadata -n settings 0 clock.force-rate 48000 > /dev/null 2>&1
      echo "Sample rate set to 48khz"
        while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    4)
      echo "-------------------------------------------"
      pw-metadata -n settings 0 clock.force-rate 96000 > /dev/null 2>&1
      echo "Sample rate set to 96khz"
      while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    5)
      echo "-------------------------------------------"
          pw-metadata -n settings 0 clock.force-rate 192000 > /dev/null 2>&1
      echo "Sample rate set to 192khz"
      while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    6)
      echo "-------------------------------------------"
      pw-metadata -n settings 0 clock.force-rate 384000 > /dev/null 2>&1
      echo "Sample rate set to 384khz"
      while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    7)
      echo "-------------------------------------------"
      pw-metadata -n settings 0 clock.force-rate 0 > /dev/null 2>&1
      echo "Sample rate reset to default"
      while true; do
        if options_prompt; then
          break
        fi
      done
      ;;
    8)
      get_current_rate
      ;;
    9)
      echo "-------------------------------------------"
      echo "PulseAudio Server Info"
      echo "-------------------------------------------"
      pactl info
      pactl stat
      ;;
    10)
      pw-top
      ;;
    *)
      echo "Invalid option"
      exit 1
      ;;
  esac
done
